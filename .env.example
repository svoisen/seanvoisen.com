# Copy to .env and fill in. .env is gitignored.

# Google Books API key, used by scripts/addbook.js for ISBN lookups.
# Without it, requests are rate-limited by IP and the script falls back to
# Open Library, which often returns mangled titles and duplicated authors.
# Create one at https://console.cloud.google.com/apis/credentials
# (enable the "Books API" for the project first).
GOOGLE_BOOKS_API_KEY=
