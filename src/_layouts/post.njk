---
layout: base
---
{%- if (page.filePathStem.split("/")[1] == "writing") %}
    {%- set type = "Writing" %}
{%- else %}
    {%- set type = "Thinking" %}
{%- endif %}

{#
    The reading view. Title, standfirst, meta row, and prose all run the full
    column. There is no back link at the top: the header nav already carries
    every route off this page. Nothing follows the prose either — no topics,
    no more-like-this — so a post ends where the writing ends.
#}
<article class="post post--{{ type | lower }}">
    <header class="post-header">
        <h1 class="post-title">{{ title }}</h1>
        {%- if description %}
        <p class="post-standfirst">{{ description }}</p>
        {%- endif %}
        <div class="post-metadata">
            <time class="post-timestamp" datetime="{{ page.date | w3Date }}">{{ page.date | monthYear }}</time>
            <span class="post-metadata__separator" aria-hidden="true">·</span>
            <span>{{ content | wordStats }}</span>
        </div>
    </header>
    <div class="post-content">
        {{ content | safe }}
    </div>
</article>
