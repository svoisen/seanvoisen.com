---
layout: base
---
{% from "macros/section-bar.njk" import sectionBar %}

{#
    A work item page opens on a section bar carrying its organisation on the
    left and the route back to the résumé on the right. That one row is what
    keeps an item with an empty body from being a dead end: a visitor arriving
    from the home page still learns where the role sat and still has somewhere
    to go next.
#}
<article class="page">
    {{ sectionBar(organisation, "Résumé", "/work/", 0) }}
    <header class="page-header">
        <h1 class="page-title">{{ title }}</h1>
        {%- if summary %}
        <div class="page-subtitle">{{ summary }}</div>
        {%- endif %}
    </header>
    <div class="page-content">
        {{ content | safe }}
    </div>
</article>
