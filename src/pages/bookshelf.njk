---
layout: page
title: Bookshelf
permalink: "/bookshelf/"
listPage: true
localCSS: ["bookshelf"]
---

{% from "macros/bookshelf-section.njk" import bookshelfSection %}
{% set intro = navigation.items | getDescription(page.url) %}

{# The page's own line, read from the directory data rather than written here,
   so the index and the sitemap cannot end up describing it differently. #}
<div class="bookshelf-intro">
    {%- if intro %}
    <p class="list-intro">{{ intro }}</p>
    {%- endif %}
    <dl class="post-facts">
        <div class="post-facts__item"><dt>Total</dt><dd>{{ books.books.length }} books</dd></div>
    </dl>
</div>

{%- for year in bookYears %}
{{ bookshelfSection(books.books, year) }}
{%- endfor %}
