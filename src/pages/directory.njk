---
layout: page
permalink: "/directory/"
title: "Directory"
listPage: true
localCSS: ["directory"]
---

{% set items = navigation.items | directoryItems %}
{% set intro = navigation.items | getDescription(page.url) %}

{# The page's own line, read from the directory data rather than written here,
   so the index and the sitemap cannot end up describing it differently. #}
{%- if intro %}
<p class="list-intro">{{ intro }}</p>
{%- endif %}

<ul class="directory-list">
{% for item in items %}
    <li class="directory-list-item">
        <a class="directory-list-item-title" href="{{ item.url }}">{{ item.url.slice(0, -1) }}</a>
        <span class="directory-list-item-description">{{ item.description }}</span>
    </li>
{% endfor %}
</ul>
