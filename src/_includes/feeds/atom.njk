<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/" xml:lang="{{ site.lang }}">
  <title>{{ title or site.title }}</title>
  <subtitle>{{ description or site.description }}</subtitle>
  <link href="{{ permalink | htmlBaseUrl(site.base) }}" rel="self" />
  <link href="{{ site.base | addPathPrefixToFullUrl }}" rel="alternate" type="text/html" />
  <updated>{{ collection | getNewestCollectionItemDate | dateToRfc3339 }}</updated>
  <id>{{ site.base | addPathPrefixToFullUrl }}</id>
  {#- Readers don't agree on which of these they show, so both point at the square master. #}
  <icon>{{ "/favicon.png" | htmlBaseUrl(site.base) }}</icon>
  <logo>{{ "/favicon.png" | htmlBaseUrl(site.base) }}</logo>
  <author>
    <name>{{ site.author.name }}</name>
    <uri>{{ site.base | addPathPrefixToFullUrl }}</uri>
  </author>
  {%- for post in collection | reverse | head(10) %}
  {%- set absolutePostUrl %}{{ post.url | htmlBaseUrl(site.base) }}{% endset %}
  {#- Same image the page's og:image carries, so the thumbnail matches whether a reader uses the feed or scrapes the page. #}
  {%- set absoluteImageUrl %}{{ (post.data.image or site.og.image) | htmlBaseUrl(site.base) }}{% endset %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ absolutePostUrl }}" rel="alternate" type="text/html" />
    <published>{{ post.date | dateToRfc3339 }}</published>
    <updated>{{ post.date | dateToRfc3339 }}</updated>
    <id>{{ post | genRSSId(site.base) }}</id>
    {%- if post.data.description %}
    <summary>{{ post.data.description }}</summary>
    {%- endif %}
    {%- for tag in post.data.tags %}
    <category term="{{ tag }}" />
    {%- endfor %}
    <media:thumbnail url="{{ absoluteImageUrl }}" />
    <media:content url="{{ absoluteImageUrl }}" medium="image" />
    <content type="html">{{ post.content | renderTransforms(post.data.page, site.base) }}</content>
  </entry>
  {%- endfor %}
</feed>
