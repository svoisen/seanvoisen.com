{
  "version": "https://jsonfeed.org/version/1.1",
  "title": {{ (title or site.title) | dump | safe }},
  "language": "{{ site.lang or page.lang }}",
  "home_page_url": "{{ site.base | addPathPrefixToFullUrl }}",
  "feed_url": "{{ permalink | htmlBaseUrl(site.base) }}",
  "description": {{ (description or site.description) | dump | safe }},
  "icon": "{{ "/favicon.png" | htmlBaseUrl(site.base) }}",
  "favicon": "{{ "/favicon-32x32.png" | htmlBaseUrl(site.base) }}",
  "authors": [
    {
      "name": "{{ site.author.name }}",
      "url": "{{ site.base | addPathPrefixToFullUrl }}"
    }
  ],
  "items": [
    {%- for post in collection | reverse | head(10) %}
    {%- set absolutePostUrl %}{{ post.url | htmlBaseUrl(site.base) }}{% endset %}
    {%- set absoluteImageUrl %}{{ (post.data.image or site.og.image) | htmlBaseUrl(site.base) }}{% endset %}
    {
      "id": "{{ post | genRSSId(site.base) }}",
      "url": "{{ absolutePostUrl }}",
      "title": {{ post.data.title | dump | safe }},
      {%- if post.data.description %}
      "summary": {{ post.data.description | dump | safe }},
      {%- endif %}
      "image": "{{ absoluteImageUrl }}",
      "tags": {{ (post.data.tags or []) | dump | safe }},
      "content_html": {% if post.content %}{{ post.content | renderTransforms(post.data.page, site.base) | dump | safe }}{% else %}""{% endif %},
      "date_published": "{{ post.date | dateToRfc3339 }}"
    }
    {% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
